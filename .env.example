# Copy to .env and edit. Never commit .env.

# --- Polling -----------------------------------------------------------
# Seconds between checks (minimum 30, enforced in code). Small random jitter is added.
SCARLETWATCH_POLL_INTERVAL=60

# --- Storage -----------------------------------------------------------
# Where the SQLite database and the course-catalog cache live (default ./data).
# Leave commented when using Docker or the systemd unit: they set it for you.
# SCARLETWATCH_DATA_DIR=./data
# How long the course catalog is cached on disk (minutes, minimum 15).
SCARLETWATCH_CATALOG_TTL_MINUTES=60

# --- Web dashboard -----------------------------------------------------
# Default 127.0.0.1:8000. The dashboard has no login, so keep it on localhost.
# Leave HOST commented when using Docker (the container must bind 0.0.0.0;
# docker-compose.yml still only publishes it on your machine's 127.0.0.1).
# SCARLETWATCH_HOST=127.0.0.1
# SCARLETWATCH_PORT=8000

# --- Registration link -------------------------------------------------
# Placeholders: {term} {year} {semester} (= term digit + year, e.g. 92026) {index} {indexes}
# Set to an empty value to fall back to https://sims.rutgers.edu/webreg/
SCARLETWATCH_REGISTER_URL_TEMPLATE=https://sims.rutgers.edu/webreg/editSchedule.htm?login=cas&semesterSelection={semester}&indexList={indexes}

# --- Notifier: ntfy (recommended; no account needed) -------------------
# Use a long random topic, it acts like a password on the public server.
SCARLETWATCH_NTFY_TOPIC=
SCARLETWATCH_NTFY_SERVER=https://ntfy.sh
# Only for protected/self-hosted servers:
SCARLETWATCH_NTFY_TOKEN=

# --- Notifier: Discord webhook ----------------------------------------
SCARLETWATCH_DISCORD_WEBHOOK_URL=

# --- Notifier: SMTP email (e.g. Gmail app password) --------------------
SCARLETWATCH_SMTP_HOST=
SCARLETWATCH_SMTP_PORT=587
SCARLETWATCH_SMTP_USERNAME=
SCARLETWATCH_SMTP_PASSWORD=
SCARLETWATCH_SMTP_FROM=
SCARLETWATCH_SMTP_TO=
# starttls | ssl | none
SCARLETWATCH_SMTP_SECURITY=starttls

# --- Notifier: Telegram bot -------------------------------------------
SCARLETWATCH_TELEGRAM_BOT_TOKEN=
SCARLETWATCH_TELEGRAM_CHAT_ID=

# --- Notifier: generic webhook (JSON POST) -----------------------------
SCARLETWATCH_WEBHOOK_URL=

# --- Notifier: desktop notification (only useful on the machine you sit at)
SCARLETWATCH_DESKTOP_NOTIFICATIONS=false

# --- Logging -----------------------------------------------------------
SCARLETWATCH_LOG_LEVEL=INFO
# text | json
SCARLETWATCH_LOG_FORMAT=text
